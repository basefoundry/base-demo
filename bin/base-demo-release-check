#!/usr/bin/env python3
"""Validate base-demo's release identity across governed metadata files."""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]


def fail(message: str) -> None:
    print(f"release identity check: {message}", file=sys.stderr)
    raise SystemExit(1)


version = (ROOT / "VERSION").read_text(encoding="utf-8").strip()
if not re.fullmatch(r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)", version):
    fail(f"VERSION is not a stable SemVer value: {version!r}")


pyproject = (ROOT / "pyproject.toml").read_text(encoding="utf-8")
pyproject_match = re.search(r'^version = "([^"]+)"$', pyproject, re.MULTILINE)
if pyproject_match is None or pyproject_match.group(1) != version:
    actual = pyproject_match.group(1) if pyproject_match else "missing"
    fail(f"pyproject.toml version {actual!r} does not match VERSION {version!r}")


for relative_path in ("services/demo-console/package.json", "services/demo-console/package-lock.json"):
    try:
        payload = json.loads((ROOT / relative_path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"could not read {relative_path}: {exc}")
    if relative_path.endswith("package-lock.json"):
        actual = payload.get("packages", {}).get("", {}).get("version")
    else:
        actual = payload.get("version")
    if actual != version:
        fail(f"{relative_path} version {actual!r} does not match VERSION {version!r}")


readme = (ROOT / "README.md").read_text(encoding="utf-8")
release_strip = (
    "![Tests](https://github.com/basefoundry/base-demo/actions/workflows/tests.yml/badge.svg)\n"
    "![Platform: macOS + Ubuntu/Debian](https://img.shields.io/badge/platform-macOS%20%2B%20Ubuntu%2FDebian-lightgrey)\n"
    f"![Version](https://img.shields.io/badge/version-{version}-blue)\n\n"
    f"[Current release: v{version}]"
    f"(https://github.com/basefoundry/base-demo/releases/tag/v{version})"
    " · [Release policy](docs/release.md)"
)
if not readme.startswith(f"# base-demo\n\n{release_strip}\n\n"):
    fail("README.md does not expose the Base-style badge strip and release links directly below the title")
if readme.count(release_strip) != 1:
    fail("README.md must contain exactly one Base-style badge strip and release-link block")
for badge in (
    "![Tests](https://github.com/basefoundry/base-demo/actions/workflows/tests.yml/badge.svg)",
    "![Platform: macOS + Ubuntu/Debian](https://img.shields.io/badge/platform-macOS%20%2B%20Ubuntu%2FDebian-lightgrey)",
    f"![Version](https://img.shields.io/badge/version-{version}-blue)",
):
    if readme.count(badge) != 1:
        fail(f"README.md must contain exactly one {badge!r} badge")
if "Current release: [v" in readme:
    fail("README.md contains the obsolete standalone current-release marker")


changelog = (ROOT / "CHANGELOG.md").read_text(encoding="utf-8")
if not re.search(rf"^## \[{re.escape(version)}\] - [0-9]{{4}}-[0-9]{{2}}-[0-9]{{2}}$", changelog, re.MULTILINE):
    fail(f"CHANGELOG.md has no dated section for {version}")


install_script = (ROOT / "install.sh").read_text(encoding="utf-8")
project_ref_match = re.search(
    r'^PROJECT_RELEASE_REF="\$\{PROJECT_RELEASE_REF:-([^}]+)\}"$',
    install_script,
    re.MULTILINE,
)
if project_ref_match is None or project_ref_match.group(1) != f"v{version}":
    actual = project_ref_match.group(1) if project_ref_match else "missing"
    fail(f"install.sh project release ref {actual!r} does not match VERSION v{version}")

project_commit_match = re.search(
    r'^PROJECT_RELEASE_COMMIT="\$\{PROJECT_RELEASE_COMMIT:-([0-9a-f]{40})\}"$',
    install_script,
    re.MULTILINE,
)
if project_commit_match is None:
    fail("install.sh must carry a 40-character base-demo release commit pin")

base_commit_match = re.search(
    r'^BASE_RELEASE_COMMIT="\$\{BASE_RELEASE_COMMIT:-([0-9a-f]{40})\}"$',
    install_script,
    re.MULTILINE,
)
if base_commit_match is None:
    fail("install.sh must carry a 40-character Base release commit pin")

if "/base/HEAD/install.sh" in install_script:
    fail("install.sh must not use Base HEAD as its release-mode installer URL")

base_checksum_match = re.search(
    r'^BASE_INSTALL_SHA256="\$\{BASE_INSTALL_SHA256-([0-9a-f]{64})\}"$',
    install_script,
    re.MULTILINE,
)
if base_checksum_match is None:
    fail("install.sh must carry a 64-character default Base installer checksum")


if len(sys.argv) > 2:
    fail("usage: bin/base-demo-release-check [vX.Y.Z]")
if len(sys.argv) == 2 and sys.argv[1] != f"v{version}":
    fail(f"tag {sys.argv[1]!r} does not match VERSION v{version}")

print(f"release identity is consistent: v{version}")
