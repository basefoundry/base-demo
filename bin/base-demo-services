#!/usr/bin/env python3
"""Service lifecycle command for the base-demo representative environment."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import signal
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, BinaryIO, NamedTuple

from base_demo_environment import (
    load_service_catalog,
    load_validated_environment,
    validate_service_name,
)


# Match base_cli.ExitCode without requiring standalone lifecycle commands to import base_cli.
SUCCESS = 0
FAILURE = 1
USAGE_ERROR = 2


class CheckResult(NamedTuple):
    ok: bool
    label: str
    detail: str


class ProcessIdentity(NamedTuple):
    process_group_id: int
    start_time: str


class ProcessStateStatus(NamedTuple):
    kind: str
    pid: int | None
    process_group_id: int | None


class LifecyclePlan(NamedTuple):
    compose_names: tuple[str, ...]
    process_entries: tuple[dict[str, Any], ...]


class ProcessStartResult(NamedTuple):
    exit_code: int
    started: bool
    rollback_failure: str | None = None
    process: subprocess.Popen[Any] | None = None


def project_root() -> Path:
    root = os.environ.get("BASE_PROJECT_ROOT")
    if root:
        return Path(root).resolve()
    return Path(__file__).resolve().parents[1]


def compose_file(root: Path) -> Path:
    return root / "infra" / "compose.yaml"


def compose_project_name(root: Path, environment_name: str) -> str:
    override = os.environ.get("BASE_DEMO_COMPOSE_PROJECT")
    if override is not None:
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]*", override):
            raise ValueError(
                "BASE_DEMO_COMPOSE_PROJECT must start with a lowercase letter or digit "
                "and contain only lowercase letters, digits, hyphens, or underscores"
            )
        return override

    environment_slug = re.sub(r"[^a-z0-9]+", "-", environment_name.lower()).strip("-")
    if not environment_slug:
        raise ValueError("environment name cannot derive an empty Compose project segment")
    checkout_digest = hashlib.sha256(str(root.resolve()).encode()).hexdigest()[:10]
    return f"base-demo-{environment_slug}-{checkout_digest}"


def compose_service_names(services: list[dict[str, Any]]) -> list[str]:
    names: list[str] = []
    for service in services:
        compose_name = service.get("compose_service")
        if isinstance(compose_name, str) and compose_name:
            names.append(compose_name)
    return names


def process_services(services: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [
        service
        for service in services
        if (service.get("lifecycle") or {}).get("type") == "process"
    ]


def select_environment_services(
    services: list[dict[str, Any]],
    environment: dict[str, Any],
    *,
    retain_unconfigured: bool = False,
) -> list[dict[str, Any]]:
    service_overrides = environment["services"]
    infrastructure = environment["infrastructure"]
    selected: list[dict[str, Any]] = []

    for service in services:
        name = service.get("name")
        if not isinstance(name, str) or not name:
            continue

        if name in service_overrides:
            configured = dict(service)
            override = service_overrides[name]
            if isinstance(override, dict) and isinstance(override.get("required"), bool):
                configured["required"] = override["required"]
            selected.append(configured)
            continue

        if name in infrastructure:
            override = infrastructure[name]
            if not isinstance(override, dict) or override.get("enabled") is not True:
                continue
            configured = dict(service)
            if isinstance(override.get("port"), int):
                configured["port"] = override["port"]
            selected.append(configured)
            continue

        if retain_unconfigured:
            selected.append(dict(service))

    return selected


def environment_is_operational(environment: dict[str, Any]) -> bool:
    return environment.get("mode") == "operational" and environment.get("operational") is True


def reject_modeled_lifecycle(environment: dict[str, Any], command: str) -> int | None:
    if command not in {"start", "stop", "restart"} or environment_is_operational(environment):
        return None
    name = environment.get("name", "unknown")
    print(
        f"ERROR: environment '{name}' is modeled and not operational; "
        "modeled environments are configuration examples, not deployable targets.",
        file=sys.stderr,
    )
    return USAGE_ERROR


def process_command(service: dict[str, Any]) -> list[str]:
    lifecycle = service.get("lifecycle") or {}
    command = lifecycle.get("command")
    if not isinstance(command, list) or not all(isinstance(item, str) for item in command):
        raise ValueError(f"{service.get('name', '-')}: process lifecycle command must be a string array")
    return command


def state_dir(root: Path) -> Path:
    configured = os.environ.get("BASE_DEMO_SERVICES_STATE_DIR")
    directory = Path(configured).expanduser() if configured else root / "var" / "services"
    if directory.is_symlink():
        raise ValueError(f"service state directory must not be a symbolic link: {directory}")
    return directory.resolve()


def ensure_private_state_directory(root: Path) -> Path:
    directory = state_dir(root)
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not directory.is_dir() or directory.is_symlink():
        raise ValueError(f"service state path is not a safe directory: {directory}")
    directory.chmod(0o700)
    return directory


def process_artifact_path(root: Path, service: dict[str, Any], suffix: str) -> Path:
    name = validate_service_name(service.get("name"), "service name")
    directory = state_dir(root)
    path = directory / f"{name}{suffix}"
    if path.parent != directory or path.is_symlink():
        raise ValueError(f"service artifact path is not a safe state-directory child: {path}")
    try:
        resolved = path.resolve(strict=False)
    except RuntimeError as exc:
        raise ValueError(f"service artifact path cannot be resolved safely: {path}") from exc
    if resolved.parent != directory or (path.exists() and not path.is_file()):
        raise ValueError(f"service artifact path is not a safe state-directory file: {path}")
    return path


def process_state_path(root: Path, service: dict[str, Any]) -> Path:
    return process_artifact_path(root, service, ".json")


def process_log_path(root: Path, service: dict[str, Any]) -> Path:
    return process_artifact_path(root, service, ".log")


def validate_process_artifact_paths(services: list[dict[str, Any]], root: Path) -> None:
    for service in process_services(services):
        process_state_path(root, service)
        process_log_path(root, service)


def open_private_log_file(path: Path) -> BinaryIO:
    flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags, 0o600)
    except OSError as exc:
        raise ValueError(f"cannot safely open service log file {path}: {exc}") from exc
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise ValueError(f"service log path is not a regular file: {path}")
        os.fchmod(descriptor, 0o600)
        return os.fdopen(descriptor, "ab")
    except Exception:
        os.close(descriptor)
        raise


def write_private_state(path: Path, payload: dict[str, Any]) -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent
    )
    temporary_path = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            descriptor = -1
            json.dump(payload, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        if path.is_symlink():
            raise ValueError(f"service state path became a symbolic link: {path}")
        os.replace(temporary_path, path)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass


def read_process_state(root: Path, service: dict[str, Any]) -> dict[str, Any] | None:
    path = process_state_path(root, service)
    try:
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise ValueError(f"cannot safely read service state file {path}: {exc}") from exc
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise ValueError(f"service state path is not a regular file: {path}")
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, encoding="utf-8") as handle:
            descriptor = -1
            payload = json.load(handle)
    except json.JSONDecodeError:
        return None
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    return payload if isinstance(payload, dict) else None


def process_is_running(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def process_identity(pid: int) -> ProcessIdentity | None:
    try:
        process_group_id = os.getpgid(pid)
    except (OSError, ProcessLookupError):
        return None
    ps_path = next((path for path in (Path("/bin/ps"), Path("/usr/bin/ps")) if path.is_file()), None)
    if ps_path is None:
        return None
    try:
        result = subprocess.run(
            [str(ps_path), "-p", str(pid), "-o", "lstart="],
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError:
        return None
    start_time = result.stdout.strip()
    if result.returncode != 0 or not start_time:
        return None
    return ProcessIdentity(process_group_id, start_time)


def inspect_process_state(
    service: dict[str, Any], state: dict[str, Any] | None
) -> ProcessStateStatus:
    if state is None:
        return ProcessStateStatus("missing", None, None)
    pid = state.get("pid")
    if not isinstance(pid, int) or pid <= 0:
        return ProcessStateStatus("mismatch", None, None)
    identity = process_identity(pid)
    if identity is None:
        return ProcessStateStatus("stopped", pid, None)
    saved_group_id = state.get("process_group_id")
    saved_start_time = state.get("process_start_time")
    try:
        expected_command = process_command(service)
    except ValueError:
        return ProcessStateStatus("mismatch", pid, identity.process_group_id)
    if (
        not isinstance(saved_group_id, int)
        or saved_group_id <= 1
        or saved_group_id != pid
        or saved_group_id != identity.process_group_id
        or not isinstance(saved_start_time, str)
        or saved_start_time != identity.start_time
        or state.get("command") != expected_command
    ):
        return ProcessStateStatus("mismatch", pid, identity.process_group_id)
    return ProcessStateStatus("running", pid, identity.process_group_id)


def remove_process_state(path: Path) -> None:
    try:
        path.unlink()
    except FileNotFoundError:
        pass


def terminate_process_group(
    pid: int,
    process_group_id: int,
    process: subprocess.Popen[Any] | None = None,
) -> bool:
    def stopped() -> bool:
        if process is not None:
            return process.poll() is not None
        return not process_is_running(pid)

    try:
        os.killpg(process_group_id, signal.SIGTERM)
    except ProcessLookupError:
        return True
    for _ in range(20):
        if stopped():
            return True
        time.sleep(0.1)
    try:
        os.killpg(process_group_id, signal.SIGKILL)
    except ProcessLookupError:
        return True
    except PermissionError:
        return stopped()
    for _ in range(20):
        if stopped():
            return True
        time.sleep(0.1)
    return stopped()


def readiness_timeout(service: dict[str, Any]) -> float:
    lifecycle = service.get("lifecycle") or {}
    configured = os.environ.get("BASE_DEMO_SERVICES_START_TIMEOUT")
    value = configured if configured is not None else lifecycle.get("readiness_timeout_seconds", 10.0)
    try:
        timeout = float(value)
    except (TypeError, ValueError):
        return 10.0
    return min(max(timeout, 0.1), 120.0)


def compose_state_service_name(service: dict[str, Any]) -> str | None:
    service_name = service.get("compose_service")
    if isinstance(service_name, str) and service_name:
        return service_name
    check = service.get("check") or {}
    check_service_name = check.get("service")
    if check.get("type") == "compose" and isinstance(check_service_name, str) and check_service_name:
        return check_service_name
    return None


def compose_service_has_state(
    service: dict[str, Any], root: Path, compose_project: str
) -> bool:
    service_name = compose_state_service_name(service)
    if service_name is None or shutil.which("docker") is None:
        return False
    command = compose_command(root, compose_project, ["ps", "--services", "--all"])
    result = subprocess.run(command, check=False, capture_output=True, text=True)
    if result.returncode != 0:
        return False
    return service_name in set(result.stdout.splitlines())


def service_has_start_state(
    service: dict[str, Any],
    root: Path,
    compose_project: str,
    process_state: dict[str, Any] | None,
) -> bool:
    lifecycle = service.get("lifecycle") or {}
    if lifecycle.get("type") == "process":
        return inspect_process_state(service, process_state).kind == "running"
    return compose_service_has_state(service, root, compose_project)


def compose_command(root: Path, compose_project: str, args: list[str]) -> list[str]:
    return [
        "docker",
        "compose",
        "-f",
        str(compose_file(root)),
        "-p",
        compose_project,
        *args,
    ]


def run_compose(root: Path, compose_project: str, args: list[str]) -> int:
    command = compose_command(root, compose_project, args)
    if os.environ.get("BASE_DEMO_SERVICES_DRY_RUN") == "1":
        print(f"DRY-RUN {shlex.join(command)}")
        return SUCCESS
    if shutil.which("docker") is None:
        print("ERROR: docker is not available; cannot manage Compose services.", file=sys.stderr)
        return USAGE_ERROR
    return subprocess.run(command, check=False).returncode


def build_lifecycle_plan(services: list[dict[str, Any]], root: Path) -> LifecyclePlan:
    process_entries = tuple(process_services(services))
    for service in process_entries:
        process_command(service)
        process_state_path(root, service)
        process_log_path(root, service)
    compose_names = tuple(compose_service_names(services))
    if (
        compose_names
        and os.environ.get("BASE_DEMO_SERVICES_DRY_RUN") != "1"
        and shutil.which("docker") is None
    ):
        raise ValueError("docker is not available; cannot manage Compose services")
    return LifecyclePlan(compose_names, process_entries)


def compose_running_services(
    root: Path, compose_project: str
) -> tuple[int, set[str]]:
    if os.environ.get("BASE_DEMO_SERVICES_DRY_RUN") == "1":
        return SUCCESS, set()
    command = compose_command(
        root, compose_project, ["ps", "--services", "--status", "running"]
    )
    try:
        result = subprocess.run(command, check=False, capture_output=True, text=True)
    except OSError as exc:
        print(f"ERROR: Compose state inspection failed: {exc}", file=sys.stderr)
        return FAILURE, set()
    if result.returncode != 0:
        detail = result.stderr.strip()
        suffix = f": {detail}" if detail else ""
        print(
            f"ERROR: Compose state inspection exited {result.returncode}{suffix}",
            file=sys.stderr,
        )
        return result.returncode, set()
    return SUCCESS, set(result.stdout.splitlines())


def report_lifecycle_failure(action: str, stage: str, exit_code: int) -> None:
    sys.stdout.flush()
    print(
        f"ERROR: lifecycle {action} failed at {stage} (exit {exit_code}).",
        file=sys.stderr,
    )


def rollback_started_resources(
    root: Path,
    compose_project: str,
    compose_names: list[str],
    process_entries: list[tuple[dict[str, Any], subprocess.Popen[Any] | None]],
    initial_failures: list[str] | None = None,
) -> list[str]:
    failures = list(initial_failures or [])
    for service, process in reversed(process_entries):
        name = str(service.get("name", "-"))
        result = stop_process(service, root, process)
        if result == SUCCESS:
            print(f"ROLLBACK process:{name} ok")
        else:
            failure = f"process:{name} exit {result}"
            failures.append(failure)
            sys.stdout.flush()
            print(f"ERROR: rollback {failure}", file=sys.stderr)

    if compose_names:
        result = run_compose(root, compose_project, ["stop", *compose_names])
        label = f"compose:{','.join(compose_names)}"
        if result == SUCCESS:
            print(f"ROLLBACK {label} ok")
        else:
            failure = f"{label} exit {result}"
            failures.append(failure)
            sys.stdout.flush()
            print(f"ERROR: rollback {failure}", file=sys.stderr)

    if failures:
        sys.stdout.flush()
        print(
            f"ERROR: lifecycle start rollback failures: {'; '.join(failures)}",
            file=sys.stderr,
        )
    elif compose_names or process_entries:
        print("ROLLBACK lifecycle start complete")
    else:
        print("ROLLBACK lifecycle start had no resources to clean up")
    return failures


def start_process(
    service: dict[str, Any], root: Path, compose_project: str
) -> ProcessStartResult:
    name = str(service.get("name", "-"))
    try:
        command = process_command(service)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return ProcessStartResult(USAGE_ERROR, False)
    if os.environ.get("BASE_DEMO_SERVICES_DRY_RUN") == "1":
        print(f"DRY-RUN start {name}: {shlex.join(command)}")
        return ProcessStartResult(SUCCESS, False)

    state_path = process_state_path(root, service)
    state_status = inspect_process_state(service, read_process_state(root, service))
    if state_status.kind == "running":
        print(f"{name} already running pid={state_status.pid}")
        return ProcessStartResult(SUCCESS, False)
    if state_status.kind == "mismatch":
        print(
            f"ERROR: {name} state does not safely identify live pid={state_status.pid or '-'}; "
            "refusing to start a replacement.",
            file=sys.stderr,
        )
        return ProcessStartResult(FAILURE, False)
    remove_process_state(state_path)

    ensure_private_state_directory(root)
    log_path = process_log_path(root, service)
    env = os.environ.copy()
    env["BASE_PROJECT_ROOT"] = str(root)
    port = service.get("port")
    if port is not None:
        env["PORT"] = str(port)

    try:
        with open_private_log_file(log_path) as log_handle:
            process = subprocess.Popen(
                command,
                cwd=root,
                env=env,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
    except OSError as exc:
        print(f"ERROR: {name} could not start: {exc}", file=sys.stderr)
        return ProcessStartResult(FAILURE, False)
    identity = process_identity(process.pid)
    if identity is None:
        process.terminate()
        try:
            process.wait(timeout=2.0)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=2.0)
        remove_process_state(state_path)
        print(f"ERROR: {name} exited before process identity could be recorded.", file=sys.stderr)
        return ProcessStartResult(FAILURE, False)
    state_payload = {
        "pid": process.pid,
        "process_group_id": identity.process_group_id,
        "process_start_time": identity.start_time,
        "started_at": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
        "command": command,
        "log": str(log_path),
    }
    try:
        write_private_state(state_path, state_payload)
    except (OSError, ValueError) as exc:
        stopped = terminate_process_group(process.pid, identity.process_group_id, process)
        print(f"ERROR: {name} state could not be recorded atomically: {exc}", file=sys.stderr)
        rollback_failure = None if stopped else f"process:{name} could not be stopped"
        return ProcessStartResult(FAILURE, False, rollback_failure)

    deadline = time.monotonic() + readiness_timeout(service)
    survival_deadline = time.monotonic() + 0.2
    last_result = CheckResult(False, "process", "process:not ready")
    while time.monotonic() < deadline:
        return_code = process.poll()
        if return_code is not None:
            remove_process_state(state_path)
            print(f"ERROR: {name} exited during startup with status {return_code}.", file=sys.stderr)
            return ProcessStartResult(FAILURE, False)
        last_result = check_service(service, root, compose_project)
        if last_result.ok and time.monotonic() >= survival_deadline:
            print(f"{name} started pid={process.pid}")
            return ProcessStartResult(SUCCESS, True, process=process)
        time.sleep(0.1)

    stopped = terminate_process_group(process.pid, identity.process_group_id, process)
    try:
        process.wait(timeout=2.0)
    except subprocess.TimeoutExpired:
        pass
    remove_process_state(state_path)
    print(f"ERROR: {name} failed readiness: {last_result.detail}.", file=sys.stderr)
    rollback_failure = None if stopped else f"process:{name} could not be stopped"
    return ProcessStartResult(FAILURE, False, rollback_failure)


def stop_process(
    service: dict[str, Any],
    root: Path,
    process: subprocess.Popen[Any] | None = None,
) -> int:
    name = str(service.get("name", "-"))
    if os.environ.get("BASE_DEMO_SERVICES_DRY_RUN") == "1":
        print(f"DRY-RUN stop {name}")
        return SUCCESS
    state_path = process_state_path(root, service)
    state = read_process_state(root, service)
    state_status = inspect_process_state(service, state)
    if state_status.kind in {"missing", "stopped"}:
        remove_process_state(state_path)
        print(f"{name} stopped")
        return SUCCESS
    if state_status.kind != "running" or state_status.pid is None or state_status.process_group_id is None:
        remove_process_state(state_path)
        print(
            f"ERROR: {name} state does not match live pid={state_status.pid or '-'}; "
            "refusing to signal it.",
            file=sys.stderr,
        )
        return FAILURE

    if not terminate_process_group(
        state_status.pid, state_status.process_group_id, process
    ):
        print(f"ERROR: {name} did not stop after SIGTERM and SIGKILL.", file=sys.stderr)
        return FAILURE
    remove_process_state(state_path)
    print(f"{name} stopped")
    return SUCCESS


def check_service(
    service: dict[str, Any], root: Path, compose_project: str
) -> CheckResult:
    check = service.get("check") or {"type": "none"}
    check_type = check.get("type")

    lifecycle = service.get("lifecycle") or {}
    if lifecycle.get("type") == "process":
        state_status = inspect_process_state(service, read_process_state(root, service))
        if state_status.kind != "running":
            label = "process" if check_type in {"none", "process"} else str(service.get("health_url") or check_type)
            return CheckResult(False, label, f"process:{state_status.kind}")

    if check_type == "process":
        return CheckResult(True, "process", "process:running")

    if check_type == "none":
        return CheckResult(True, "none", "none")

    if check_type == "file":
        path_value = check.get("path")
        if not isinstance(path_value, str) or not path_value:
            return CheckResult(False, "file:<missing path>", "file:<missing path>")
        path = Path(path_value)
        if not path.is_absolute():
            path = root / path
        label = f"file:{path_value}"
        return CheckResult(path.exists(), label, label)

    if check_type == "http":
        url = service.get("health_url")
        if not isinstance(url, str) or not url:
            return CheckResult(False, "http:<missing health_url>", "http:<missing health_url>")
        label = url
        try:
            with urllib.request.urlopen(url, timeout=1.0) as response:
                return CheckResult(200 <= response.status < 400, label, f"http:{url}")
        except (OSError, urllib.error.URLError) as exc:
            return CheckResult(False, label, f"http:{url} ({exc})")

    if check_type == "compose":
        service_name = check.get("service") or service.get("compose_service") or service.get("name")
        if not isinstance(service_name, str) or not service_name:
            return CheckResult(False, "compose:<missing service>", "compose:<missing service>")
        label = f"compose:{service_name}"
        if shutil.which("docker") is None:
            return CheckResult(False, label, f"{label} unavailable")
        command = compose_command(
            root, compose_project, ["ps", "--services", "--status", "running"]
        )
        result = subprocess.run(command, check=False, capture_output=True, text=True)
        running = set(result.stdout.splitlines())
        return CheckResult(service_name in running, label, label)

    if check_type == "command":
        command = check.get("command")
        if not isinstance(command, list) or not all(isinstance(item, str) for item in command):
            return CheckResult(False, "command:<invalid command>", "command:<invalid command>")
        label = f"command:{shlex.join(command)}"
        try:
            result = subprocess.run(command, cwd=root, check=False, capture_output=True, text=True, timeout=3.0)
        except (FileNotFoundError, PermissionError, subprocess.TimeoutExpired) as exc:
            return CheckResult(False, label, f"{label} ({exc})")
        return CheckResult(result.returncode == 0, label, label)

    detail = f"unsupported:{check_type}"
    return CheckResult(False, detail, detail)


def service_rows(
    services: list[dict[str, Any]], root: Path, compose_project: str
) -> list[dict[str, str]]:
    rows: list[dict[str, str]] = []
    for service in services:
        process_state = read_process_state(root, service)
        check_result = check_service(service, root, compose_project)
        if check_result.ok:
            state = "healthy"
        elif service.get("required", False):
            state = "unhealthy"
        elif (service.get("lifecycle") or {}).get("type") == "process" and inspect_process_state(
            service, process_state
        ).kind == "mismatch":
            state = "error"
        elif service_has_start_state(service, root, compose_project, process_state):
            state = "error"
        else:
            state = "stopped"
        since = "-"
        if process_state and inspect_process_state(service, process_state).kind in {"running", "mismatch"}:
            started_at = process_state.get("started_at")
            if isinstance(started_at, str) and started_at:
                since = started_at
        rows.append(
            {
                "name": str(service.get("name", "-")),
                "kind": str(service.get("kind", "-")),
                "runtime": str(service.get("runtime", "-")),
                "port": str(service.get("port") or "-"),
                "health": check_result.label,
                "state": state,
                "since": since,
                "logs": str(service.get("logs") or "-"),
                "detail": check_result.detail,
                "required": "true" if service.get("required", False) else "false",
            }
        )
    return rows


def print_table(rows: list[dict[str, str]]) -> None:
    headers = ("NAME", "KIND", "RUNTIME", "PORT", "HEALTH", "STATE", "SINCE", "LOGS")
    keys = ("name", "kind", "runtime", "port", "health", "state", "since", "logs")
    widths = {
        key: max(len(header), *(len(row[key]) for row in rows)) if rows else len(header)
        for key, header in zip(keys, headers)
    }
    print("  ".join(header.ljust(widths[key]) for key, header in zip(keys, headers)))
    for row in rows:
        print("  ".join(row[key].ljust(widths[key]) for key in keys))


def cmd_status(
    services: list[dict[str, Any]],
    root: Path,
    environment: dict[str, Any],
    compose_project: str,
) -> int:
    env_name = str(environment.get("name", "dev"))
    print(f"environment={env_name}")
    print(f"mode={environment.get('mode', 'operational')}")
    print(f"operational={str(environment.get('operational', False)).lower()}")
    print(f"compose_project={compose_project}")
    rows = service_rows(services, root, compose_project)
    if not rows:
        print("No services configured.")
        return SUCCESS
    print_table(rows)
    return SUCCESS


def cmd_check(services: list[dict[str, Any]], root: Path, compose_project: str) -> int:
    failed = False
    for row in service_rows(services, root, compose_project):
        if row["state"] == "healthy":
            print(f"{row['name']} ok")
            continue
        if row["state"] == "error":
            print(f"{row['name']} error {row['detail']}")
            failed = True
            continue
        if row["required"] == "true":
            print(f"{row['name']} fail {row['detail']}")
            failed = True
        else:
            print(f"{row['name']} skip optional {row['detail']}")
    return FAILURE if failed else SUCCESS


def start_lifecycle(plan: LifecyclePlan, root: Path, compose_project: str) -> int:
    compose_started: list[str] = []
    process_started: list[
        tuple[dict[str, Any], subprocess.Popen[Any] | None]
    ] = []

    if plan.compose_names:
        inspect_result, running_before = compose_running_services(root, compose_project)
        if inspect_result != SUCCESS:
            report_lifecycle_failure("start", "compose-state", inspect_result)
            return inspect_result
        compose_started = [
            name for name in plan.compose_names if name not in running_before
        ]
        compose_result = run_compose(
            root, compose_project, ["up", "-d", *plan.compose_names]
        )
        if compose_result != SUCCESS:
            report_lifecycle_failure("start", "compose", compose_result)
            rollback_started_resources(
                root, compose_project, compose_started, process_started
            )
            return compose_result

    for service in plan.process_entries:
        name = str(service.get("name", "-"))
        sys.stdout.flush()
        process_result = start_process(service, root, compose_project)
        if process_result.exit_code != SUCCESS:
            report_lifecycle_failure(
                "start", f"process:{name}", process_result.exit_code
            )
            initial_failures = (
                [process_result.rollback_failure]
                if process_result.rollback_failure is not None
                else []
            )
            rollback_started_resources(
                root,
                compose_project,
                compose_started,
                process_started,
                initial_failures,
            )
            return process_result.exit_code
        if process_result.started:
            process_started.append((service, process_result.process))
    return SUCCESS


def stop_lifecycle(plan: LifecyclePlan, root: Path, compose_project: str) -> int:
    failures: list[tuple[str, int]] = []
    if plan.compose_names:
        compose_result = run_compose(
            root, compose_project, ["stop", *plan.compose_names]
        )
        if compose_result != SUCCESS:
            failures.append(("compose", compose_result))

    for service in plan.process_entries:
        name = str(service.get("name", "-"))
        process_result = stop_process(service, root)
        if process_result != SUCCESS:
            failures.append((f"process:{name}", process_result))

    for stage, exit_code in failures:
        report_lifecycle_failure("stop", stage, exit_code)
    return failures[0][1] if failures else SUCCESS


def lifecycle_start_preflight(
    plan: LifecyclePlan, root: Path, action: str
) -> int:
    for service in plan.process_entries:
        state_status = inspect_process_state(service, read_process_state(root, service))
        if state_status.kind != "mismatch":
            continue
        name = str(service.get("name", "-"))
        print(
            f"ERROR: lifecycle {action} preflight failed at process:{name}: "
            f"state does not safely identify live pid={state_status.pid or '-'}. ",
            "No services were mutated and no replacement was started.",
            sep="",
            file=sys.stderr,
        )
        return FAILURE
    return SUCCESS


def cmd_lifecycle(
    services: list[dict[str, Any]], root: Path, compose_project: str, action: str
) -> int:
    plan = build_lifecycle_plan(services, root)
    if action == "start":
        preflight_result = lifecycle_start_preflight(plan, root, action)
        if preflight_result != SUCCESS:
            return preflight_result
        return start_lifecycle(plan, root, compose_project)
    if action == "stop":
        return stop_lifecycle(plan, root, compose_project)
    if action == "restart":
        preflight_result = lifecycle_start_preflight(plan, root, action)
        if preflight_result != SUCCESS:
            return preflight_result
        stop_result = stop_lifecycle(plan, root, compose_project)
        if stop_result != SUCCESS:
            print(
                f"ERROR: lifecycle restart aborted after stop failure (exit {stop_result}); "
                "no replacement services were started.",
                file=sys.stderr,
            )
            return stop_result
        return start_lifecycle(plan, root, compose_project)
    raise AssertionError(f"unhandled lifecycle action: {action}")


def cmd_logs(services: list[dict[str, Any]], root: Path, compose_project: str) -> int:
    result = 0
    compose_names = compose_service_names(services)
    if compose_names:
        result = run_compose(
            root, compose_project, ["logs", "--tail", "50", *compose_names]
        )
    for service in process_services(services):
        name = service.get("name", "-")
        log_path = process_log_path(root, service)
        if os.environ.get("BASE_DEMO_SERVICES_DRY_RUN") == "1":
            print(f"DRY-RUN logs {name}: {log_path}")
            continue
        if not log_path.exists():
            print(f"{name} logs unavailable")
            continue
        print(f"==> {name} {log_path} <==")
        try:
            descriptor = os.open(log_path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        except OSError as exc:
            raise ValueError(f"cannot safely read service log file {log_path}: {exc}") from exc
        try:
            if not stat.S_ISREG(os.fstat(descriptor).st_mode):
                raise ValueError(f"service log path is not a regular file: {log_path}")
            os.fchmod(descriptor, 0o600)
            with os.fdopen(descriptor, encoding="utf-8") as handle:
                descriptor = -1
                print(handle.read()[-4000:], end="")
        finally:
            if descriptor >= 0:
                os.close(descriptor)
    return result


def parse_args(argv: list[str]) -> argparse.Namespace:
    root = project_root()
    parser = argparse.ArgumentParser(description="Manage base-demo representative services.")
    parser.add_argument("--catalog", default=str(root / "services" / "catalog.json"))
    parser.add_argument("--env", default="dev")
    parser.add_argument("command", choices=("status", "start", "stop", "restart", "check", "logs"))
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])
    root = project_root()
    try:
        environment = load_validated_environment(root, args.env)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return USAGE_ERROR
    rejected = reject_modeled_lifecycle(environment, args.command)
    if rejected is not None:
        return rejected
    try:
        compose_project = compose_project_name(root, str(environment["name"]))
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return USAGE_ERROR

    try:
        catalog_path = Path(args.catalog).resolve()
        services = select_environment_services(
            load_service_catalog(catalog_path),
            environment,
            retain_unconfigured=catalog_path
            != (root / "services" / "catalog.json").resolve(),
        )
        validate_process_artifact_paths(services, root)

        if args.command == "status":
            return cmd_status(services, root, environment, compose_project)
        if args.command == "check":
            return cmd_check(services, root, compose_project)
        if args.command in {"start", "stop", "restart"}:
            return cmd_lifecycle(services, root, compose_project, args.command)
        if args.command == "logs":
            return cmd_logs(services, root, compose_project)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return USAGE_ERROR

    raise AssertionError(f"unhandled command: {args.command}")


if __name__ == "__main__":
    raise SystemExit(main())
