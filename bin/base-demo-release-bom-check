#!/usr/bin/env python3
"""Verify a finalized BOM against governed schema, supported pins and live runs."""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib/release_contract"))
from demo_bom import check


def main():
    try:
        path = Path(os.environ.get("BASE_DEMO_RELEASE_BOM_PATH", ROOT / ".release/release-bom.json"))
        inputs = Path(os.environ.get("BASE_DEMO_RELEASE_INPUTS_PATH", ROOT / ".release/supported-dependencies.json"))
        check(
            json.loads(path.read_text()), json.loads(inputs.read_text()),
            (ROOT / "VERSION").read_text().strip(),
            os.environ.get("BASE_DEMO_RELEASE_BOM_EXPECTED_COMMIT"),
        )
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired) as exc:
        print(f"release BOM check: {exc}", file=sys.stderr)
        return 1
    print("release BOM identity, supported inputs and live compatibility evidence are consistent")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
